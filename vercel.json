{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/checkout/route.ts": {
      "maxDuration": 15
    },
    "src/app/api/respond/route.ts": {
      "maxDuration": 30
    }
  }
}
